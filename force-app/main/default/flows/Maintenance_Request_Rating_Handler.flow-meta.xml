        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Satisfied</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName} = 'Maintenance_Request' &amp;&amp; ISCHANGED({!$Record.Satisfaction_Rating__c}) &amp;&amp; NOT(ISBLANK({!$Record.Satisfaction_Rating__c})) &amp;&amp; TEXT(PRIORVALUE({!$Record.Status})) = 'Resolved'</filterFormula>
        <object>Case</object>
