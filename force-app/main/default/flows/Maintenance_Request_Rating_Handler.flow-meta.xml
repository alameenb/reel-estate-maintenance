<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Is_Satisfied</name>
        <label>Rating 3 or more?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Close_Parent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>1 or 2</defaultConnectorLabel>
        <rules>
            <name>Satisfied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Satisfaction_Rating__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Response</targetReference>
            </connector>
            <label>3 to 5</label>
        </rules>
    </decisions>
    <description>CMP-118. Rating 3-5 stamps the response date; 1-2 closes the case and opens a linked follow-up request.</description>
    <formulas>
        <name>ChildSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('Follow-up: ' &amp; {!$Record.Subject}, 255)</expression>
    </formulas>
    <formulas>
        <name>ChildDescription</name>
        <dataType>String</dataType>
        <expression>'Follow-up to request ' &amp; {!$Record.CaseNumber} &amp; ', rated ' &amp; TEXT({!$Record.Satisfaction_Rating__c}) &amp; ' by the customer.' &amp; BR() &amp; {!$Record.Description}</expression>
    </formulas>
    <formulas>
        <name>ParentNote</name>
        <dataType>String</dataType>
        <expression>'Customer rated ' &amp; TEXT({!$Record.Satisfaction_Rating__c}) &amp; '. Request closed and follow-up request created.'</expression>
    </formulas>
    <formulas>
        <name>ChildNote</name>
        <dataType>String</dataType>
        <expression>'Follow-up to request ' &amp; {!$Record.CaseNumber} &amp; ' (rated ' &amp; TEXT({!$Record.Satisfaction_Rating__c}) &amp; ').'</expression>
    </formulas>
