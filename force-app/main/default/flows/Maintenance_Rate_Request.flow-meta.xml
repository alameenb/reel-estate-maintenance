    <decisions>
        <name>Can_Rate</name>
        <label>Can rate?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cannot_Rate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resolved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Satisfaction_Rating__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rate</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>CMP-117. Portal screen flow: customer rates a resolved request 1-5.</description>
    <interviewLabel>Rate Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rate Your Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
