  "deviations": [
    {
      "component_key": "CMP-026",
      "reason": "Classic HTML email templates merged in memory instead of Lightning templates (bulk-safe; renderStoredEmailTemplate costs queries per email).",
      "proposed_design_change": "Accept; revisit if the business needs Lightning template editing."
    },
    {
      "component_key": "CMP-085",
      "reason": "RequestAssignmentService runs without sharing (audit data written for any user from the trigger).",
      "proposed_design_change": "Accept as documented exception."
    },
    {
      "component_key": "CMP-028",
      "reason": "Shared MaintenanceMessaging helper reads customer contact details in system mode; reminder flow uses an invocable action instead of Send Email elements.",
      "proposed_design_change": "Accept."
    },
    {
      "component_key": "CMP-006",
      "reason": "Guest/portal-created requests are routed through the Maintenance_Routing__e platform event (Automated Process user), because those licences cannot access Omni-Channel objects.",
      "proposed_design_change": "Add Maintenance_Routing__e and MaintenanceRoutingTrigger to the design."
    },
    {
      "component_key": "CMP-018",
      "reason": "Sharing set grants Edit, not Read, so customers can save their rating (CMP-117/119).",
      "proposed_design_change": "Update CMP-018 access to Edit; field security limits changes to the rating."
    },
    {
      "component_key": "CMP-030",
      "reason": "Record type checked by Id lookup instead of an entry formula (cross-object formulas are not evaluated on create in before-save flows).",
      "proposed_design_change": "Accept."
    },
    {
      "component_key": "CMP-062",
      "reason": "Radio-button choice lists instead of data tables; postcode-only property search.",
      "proposed_design_change": "Accept for MVP."
    },
    {
      "component_key": "CMP-061",
      "reason": "Quick-action visibility filters not set (also CMP-111, CMP-114); flows refuse with a clear message.",
      "proposed_design_change": "Add Dynamic Actions visibility in a follow-up."
    },
    {
      "component_key": "CMP-130",
      "reason": "Team and supervisor access verified by scripts/apex/verify-sharing.apex on real records (36/36), because this org calculates criteria-based shares asynchronously (also CMP-076).",
      "proposed_design_change": "Accept; run the script after every deployment."
    },
    {
      "component_key": "CMP-075",
      "reason": "Dashboard overdue table component not included.",
      "proposed_design_change": "Add in a follow-up."
    }
  ],
